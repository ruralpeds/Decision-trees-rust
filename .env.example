# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Database
DATABASE_URL=postgres://cds_user:cds_password@localhost:5432/cds_tree

# JWT/Auth
JWT_PUBLIC_KEY=your-public-key-here
JWT_ISSUER=https://auth.example.com

# Logging
RUST_LOG=info,cds_tree_api=debug,tower_http=debug

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.example.com

# Rate limiting
RATE_LIMIT_PER_IP=100

# Database migrations
AUTO_MIGRATE=true
