      "outcome": {
        "severity": "critical",
        "title": "Moderate-to-Severe Respiratory Distress — Level III Care Required",
        "summary": "Patient exhibits moderate-to-severe respiratory distress. Transfer to a Level III NICU is strongly recommended for specialized management.",
        "full_recommendation": "**URGENT:** Consider immediate transfer to a Level III NICU equipped with:\n- Mechanical ventilation capability\n- Extracorporeal membrane oxygenation (ECMO) available\n- Pediatric surgery on-site\n\n**While arranging transfer:**\n1. Place on continuous cardiorespiratory monitoring\n2. Provide 100% oxygen if SpO2 < 90%\n3. Obtain IV access (umbilical venous catheter preferred for central access)\n4. Stat labs: CBC, blood culture, blood gas, chest X-ray\n5. NPO status (hold feeding)\n6. Consider empiric antibiotics pending culture results\n7. Notify NICU attending and transport team\n8. Prepare for intubation and mechanical ventilation\n\n**Do NOT delay transfer waiting for diagnostic results.**",
        "rationale": "Moderate-to-severe respiratory distress in neonates indicates significant pulmonary pathology (respiratory distress syndrome, meconium aspiration, infection, etc.) requiring intensive respiratory support beyond the capabilities of most Critical Access Hospitals.",
        "evidence_refs": [
          {
            "ref_type": "Guideline",
            "title": "AAP Levels of Neonatal Care",
            "url": "https://publications.aap.org/pediatrics/article/154/4/e20241996/",
            "pmid": null,
            "doi": "10.1542/peds.2024-1996",
            "publication_year": 2024
          }
        ],
        "actions": [
          {
            "action_type": "EmergencyAction",
            "label": "Activate neonatal transport",
            "description": "Call regional NICU transport team immediately"
          },
          {
