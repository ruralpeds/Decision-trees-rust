      "outcome": {
        "severity": "warning",
        "title": "Mild Respiratory Distress",
        "summary": "Patient exhibits mild respiratory distress. Observation and supportive care recommended.",
        "full_recommendation": "1. Maintain continuous pulse oximetry and cardiac monitoring\n2. Provide supplemental oxygen if SpO2 < 90% (target 90-95%)\n3. Ensure adequate feeding (breastfeeding or IV nutrition)\n4. Monitor for progression\n5. Assess for underlying causes (infection, aspiration)\n6. Repeat examination every 2-4 hours\n\nConsider escalation to higher level of care if:\n- Respiratory rate > 80/min persists beyond 6 hours\n- SpO2 cannot be maintained > 90% on room air\n- Signs of sepsis develop\n- Feeding becomes compromised",
        "rationale": "Mild respiratory distress in term/near-term neonates is often transient and self-limiting when managed with supportive care.",
        "evidence_refs": [
          {
            "ref_type": "Guideline",
            "title": "AAP Neonatal Respiratory Management",
            "url": "https://aap.org",
            "pmid": null,
            "doi": null,
            "publication_year": 2023
          }
        ],
        "actions": [
